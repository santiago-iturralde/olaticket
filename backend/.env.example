DB_USER=user
DB_PASSWORD=userpassword
DB_HOST=localhost
DB_PORT=3306
DB_NAME=stockdb
# Con un DB_HOST externo (ej. TiDB Cloud: *.tidbcloud.com, puerto 4000) se agrega tls=true solo.
# localhost, IPs privadas y servicios de Docker ("db") van sin TLS. DB_TLS lo fuerza si hace falta:
# true, false, skip-verify o preferred.
# DB_TLS=true
REDIS_HOST=localhost
REDIS_PORT=6379
# Producción (ej. Upstash): URL completa; si está, se ignoran REDIS_HOST y REDIS_PORT.
# rediss:// (con doble s) = conexión con TLS. Cargala como variable secreta del hosting,
# no en un archivo que se suba al repositorio.
# REDIS_URL=rediss://default:<clave>@<tu-base>.upstash.io:6379
# Cada cuántos segundos se buscan reservas vencidas (por defecto 5). Con Upstash, 30 ahorra
# comandos: ~86 mil por mes en vez de ~520 mil.
# RESERVATION_SWEEP_SECONDS=30
PORT=8080
# Puerto de /metrics (Prometheus). Separado del público: no lo expongas a internet.
METRICS_PORT=9091
JWT_SECRET=replace-with-a-long-random-secret

# Mercado Pago. Si MP_ACCESS_TOKEN queda vacío se activa el modo SANDBOX/MOCK local.
MP_ACCESS_TOKEN=
# Clave secreta de la sección Webhooks de tu aplicación en Mercado Pago (valida x-signature).
MP_WEBHOOK_SECRET=
# URL pública HTTPS del backend para recibir el webhook (ej. túnel ngrok).
PUBLIC_API_URL=http://localhost:8080
# Desde otro dispositivo de la LAN: http://<IP-Wi-Fi>:8080
# A dónde vuelve el usuario después de pagar.
FRONTEND_URL=http://localhost:5173
# Desde otro dispositivo de la LAN: http://<IP-Wi-Fi> (Docker) o http://<IP-Wi-Fi>:5173 (npm run dev)

# Email de entradas (SMTP). Si SMTP_USER o SMTP_PASS quedan vacíos no se envían emails.
# Con Gmail: SMTP_PASS es un App Password (https://myaccount.google.com/apppasswords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remitente; por defecto SMTP_USER.
SMTP_FROM=

# Cloudinary (portadas y mapas de eventos): cloudinary://<api_key>:<api_secret>@<cloud_name>
# Se copia del dashboard de Cloudinary (API Environment variable). Vacío = no se pueden subir imágenes.
CLOUDINARY_URL=

# reCAPTCHA v2 del login. Vacío = no se valida (solo desarrollo local).
# Esta es la clave SECRETA de PRUEBA de Google (siempre aprueba): reemplazala en producción.
RECAPTCHA_SECRET=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
