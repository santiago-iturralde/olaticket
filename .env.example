# Variables que lee docker-compose.yml (pisan las de backend/.env y frontend/.env dentro de Docker).
# Para probar desde otro dispositivo de la red, reemplazá localhost por la IP de la PC en la Wi-Fi
# (en Windows: ipconfig, adaptador "Wi-Fi"; no uses la de vEthernet/WSL).
FRONTEND_URL=http://localhost
VITE_API_URL=http://localhost:8080

# Observabilidad local (Prometheus en :9090 y Grafana en :3000). Con esta línea, un
# `docker compose up` también los levanta. No la pongas en el .env de la nube.
# COMPOSE_PROFILES=monitoring
# Usuario y clave de Grafana (por defecto admin / admin; Grafana pide cambiarla al entrar).
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=
